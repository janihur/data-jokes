<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="jokeText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="jokeType">
    <xs:simpleContent>
      <xs:extension base="jokeText">
        <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="date" type="xs:date" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="monthType">
    <xs:sequence>
      <xs:element name="joke" type="jokeType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:gYearMonth" use="required"/>
  </xs:complexType>

  <xs:element name="jokes">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="month" type="monthType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
    </xs:complexType>
    <xs:unique name="uniqueJokeId">
      <xs:selector xpath="month/joke"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="uniqueMonth">
      <xs:selector xpath="month"/>
      <xs:field xpath="@value"/>
    </xs:unique>
  </xs:element>

</xs:schema>
