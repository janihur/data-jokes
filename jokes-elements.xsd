<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="jokeText">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="jokeType">
    <xs:sequence>
      <xs:element name="id" type="xs:positiveInteger"/>
      <xs:element name="date" type="xs:date"/>
      <xs:element name="text" type="jokeText"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="jokes">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="joke" type="jokeType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="uniqueJokeId">
      <xs:selector xpath="joke"/>
      <xs:field xpath="id"/>
    </xs:unique>
  </xs:element>

</xs:schema>
